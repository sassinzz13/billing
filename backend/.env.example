# All values are optional; defaults shown.
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
LOG_LEVEL=info
# Relative paths resolve against the backend directory
DB_PATH=data/billing.db
SESSION_TTL_HOURS=8
# Dev frontend origin allowed to call the API (CORS is otherwise disabled)
DEV_FRONTEND_ORIGIN=http://localhost:5173
